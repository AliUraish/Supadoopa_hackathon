# Supabase (hosted project)
# Dashboard → Project Settings → API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only — never expose to the browser
SUPABASE_SECRET_KEY=sb_secret_xxx

# Legacy JWT keys (only if a library still needs anon/service_role)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Project ref + DB (Dashboard → Connect)
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_DB_PASSWORD=
# Transaction pooler (port 6543) — use this on Vercel/serverless
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Session pooler (port 5432) — use for migrations
DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Stripe (test mode) — Dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Server-only — never expose to the browser
STRIPE_SECRET_KEY=sk_test_xxx
# Local: `stripe listen --forward-to localhost:8000/webhooks/stripe` (handled by backend/)
# Prod: Dashboard → Developers → Webhooks → endpoint signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Billing backend (backend/, FastAPI) — see backend/README.md
# Frontend origin: Checkout and the billing portal redirect back here.
APP_URL=http://localhost:3000
# MPP pay-per-call only: Stripe Dashboard → Settings → Business profile (profile_test_…)
STRIPE_PROFILE_ID=

# Frontend → billing API base URL (server-only). Local: http://localhost:8000
BILLING_API_URL=http://localhost:8000
