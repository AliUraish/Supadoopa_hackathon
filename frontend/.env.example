# Copy to .env.local. Public values only: never put secret keys in the frontend.

# Supabase (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Doorway API (backend/, FastAPI). Server-side calls and browser calls.
DOORWAY_API_URL=http://localhost:8000
NEXT_PUBLIC_DOORWAY_API_URL=http://localhost:8000
# 1 = fixtures + a fake live stream in the browser; 0 = the real backend
NEXT_PUBLIC_DOORWAY_MOCK=1

# Billing API (backend/, server-side only)
BILLING_API_URL=http://localhost:8000
